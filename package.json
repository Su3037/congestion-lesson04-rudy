{
  "name": "congestion-lesson04-rudy",
  "version": "1.0.0",
  "private": true,
  "description": "RUDY congestion teaching module: shared domain/board/timeline, four deterministic code-drawn films (zh + en) with music and voiceover, interactive lab.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs tests/legacy/*.test.mjs && python3 -m pytest -q tests/",
    "test:browser": "node tests/browser.mjs",
    "stills": "node scripts/render.mjs --stills",
    "films": "node scripts/build-films.mjs",
    "walk": "node scripts/record-walk.mjs",
    "film": "node scripts/render.mjs --full",
    "serve": "node scripts/serve.mjs 8800 /congestion-lesson04-rudy/",
    "oracle:teacher": "node oracles/teacher_diff.mjs",
    "oracle:crosslang": "node oracles/crosslang.mjs",
    "oracle:edge": "node oracles/edge_cases.mjs",
    "oracle:upstream": "bash oracles/upstream/run.sh",
    "voice": "python3 scripts/voice/render-voice-kokoro.py --zh-voice zf_039 && python3 scripts/voice/asr_check.py"
  },
  "devDependencies": {
    "fast-check": "3.23.2",
    "playwright": "1.63.0"
  }
}
